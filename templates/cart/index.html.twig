{% extends 'base.html.twig' %}

{% block title %}Mon panier - City Lunch{% endblock %}

{% block body %}
    <main class="container">
        <h1>Mon panier</h1>

        {% if cart is null or cart.cartItems is empty %}
            <p>Votre panier est vide.</p>

            <a href="{{ path('app_product_index') }}" class="button">
                Voir les produits
            </a>
        {% else %}
            {% set total = 0 %}

            <div class="cart-list">
                {% for item in cart.cartItems %}
                    {% set lineTotal = item.product.price * item.quantity %}
                    {% set total = total + lineTotal %}

                    <article class="product-card">
                        <h2>{{ item.product.name }}</h2>

                        <p>{{ item.product.description }}</p>

                        <p>PU : {{ item.product.price }} €</p>

                        <p>Q : {{ item.quantity }}</p>

                        <p>
                            <strong>Total ligne : {{ lineTotal|number_format(2, ',', ' ') }} €</strong>
                        </p>

                        <a href="{{ path('app_cart_remove', { id: item.id }) }}" class="button">
                            Retirer
                        </a>
                    </article>
                {% endfor %}
            </div>

            <h2>Total du panier : {{ total|number_format(2, ',', ' ') }} €</h2>

            <a href="{{ path('app_cart_clear') }}" class="button">
                Vider le panier
            </a>

            <a href="{{ path('app_product_index') }}" class="button">
                Continuer mes achats
            </a>
        {% endif %}
    </main>
{% endblock %}