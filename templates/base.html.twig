<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}City Lunch{% endblock %}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">

        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% endblock %}

        {% block javascripts %}
        {% endblock %}
    </head>

    <body>
        <nav style="padding: 20px; background: #222;">
            <a href="{{ path('app_home') }}" style="color: white; margin-right: 15px; text-decoration: none;">
                City Lunch
            </a>

            <a href="{{ path('app_product_index') }}" style="color: white; margin-right: 15px; text-decoration: none;">
                Produits
            </a>

            <a href="{{ path('app_cart_index') }}" style="color: white; margin-right: 15px; text-decoration: none;">
                Panier
            </a>

            {% if app.user %}
                <span style="color: white; margin-right: 15px;">
                    Connecté : {{ app.user.userIdentifier }}
                </span>

                <a href="{{ path('app_logout') }}" style="color: white; text-decoration: none;">
                    Déconnexion
                </a>
            {% else %}
                <a href="{{ path('app_login') }}" style="color: white; margin-right: 15px; text-decoration: none;">
                    Connexion
                </a>

                <a href="{{ path('app_register') }}" style="color: white; text-decoration: none;">
                    Inscription
                </a>
            {% endif %}
        </nav>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div style="padding: 12px 20px; margin: 20px auto; max-width: 1100px; background: #e8f5e9; border: 1px solid #c8e6c9; border-radius: 8px;">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        {% block body %}{% endblock %}
    </body>
</html>